<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:theme="@style/Theme.Hex">

    <activity
        android:name=".ui.HexHomeActivity"
        android:exported="true"
        android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>

    <activity
        android:name=".ui.HexRecoveryActivity"
        android:exported="false"/>

    <service android:name=".keyboard.HexInputMethodService" android:label="Hex Keyboard"
        android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
      <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/hex_ime"/>
    </service>

    <service
        android:name=".service.HexBubbleService"
        android:label="@string/service_dictation_label"
        android:exported="true"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService"/>
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/bubble"/>
    </service>

    <service
        android:name=".cleanup.HexHintWindowService"
        android:label="@string/service_words_on_screen_label"
        android:exported="true"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService"/>
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/hint_window"/>
    </service>

    <service
        android:name=".cleanup.HexPolisherService"
        android:exported="false"
        android:process=":cleanup"/>

    <service
        android:name=".recovery.HexExpiryJobService"
        android:permission="android.permission.BIND_JOB_SERVICE"
        android:exported="false"/>

    <activity android:name=".anywhere.TypeAnywhereActivity" android:exported="false"
        android:theme="@style/Theme.Hex.TypeAnywhere" android:excludeFromRecents="true"
        android:taskAffinity="anomaly.hex.android.anywhere" android:windowSoftInputMode="adjustResize|stateAlwaysVisible"/>

    <activity android:name=".control.CopyDictationActivity" android:exported="false"
        android:theme="@style/Theme.Hex.Dialog" android:excludeFromRecents="true"
        android:taskAffinity="anomaly.hex.android.copy" android:launchMode="singleTop"/>
    <service android:name=".control.DictationTileService" android:label="Dictate with Hex"
        android:icon="@android:drawable/ic_btn_speak_now" android:exported="true"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
    </service>

    <provider
        android:name=".keyboard.TypingTelemetryProvider"
        android:authorities="anomaly.hex.android.telemetry"
        android:exported="false"
        android:grantUriPermissions="true"/>

    <receiver
        android:name=".control.HexControlReceiver"
        android:exported="true"
        android:permission="android.permission.DUMP"/>
  </application>
</manifest>
